{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":preserveSemverRanges"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "1 day",
  "labels": ["dependencies"],
  "postUpdateOptions": ["pnpmDedupe"],
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Catch-all: every minor/patch/pin update not covered by a more specific group below lands in one PR",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "Non-major dependencies"
    },
    {
      "description": "Local path packages (web/modules/custom, web/themes/custom, misc/scaffold): not published anywhere, nothing to look up",
      "matchPackageNames": ["workspace/**"],
      "enabled": false
    },
    {
      "description": "DDEV images (site and scaffold): local dev only, DDEV and its add-ons manage them",
      "matchFileNames": ["**/.ddev/**"],
      "matchDatasources": ["docker"],
      "enabled": false
    },
    {
      "description": "Our own FrankenPHP image: rebuilt often and deployed by tag, no digest pinning or updates",
      "matchPackageNames": ["ghcr.io/woldtwerk-websites/frankenphp-drupal"],
      "enabled": false
    },
    {
      "description": "npm-asset packages from inline composer package repositories: no registry to look up, update by hand",
      "matchPackageNames": ["npm-asset/**"],
      "enabled": false
    },
    {
      "description": "Dev tooling (PHPUnit, coder, phpstan, ...): automerge minor/patch after green CI",
      "matchDepTypes": ["require-dev", "devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Dev dependencies",
      "automerge": true,
      "reviewers": ["team:maintainers"]
    },
    {
      "description": "GitHub Actions: grouped, no automerge",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": false,
      "reviewers": ["team:maintainers"]
    },
    {
      "description": "Drupal contrib: grouped, human review",
      "matchPackageNames": [
        "drupal/*",
        "!drupal/core",
        "!drupal/core-*"
      ],
      "groupName": "Drupal contrib",
      "labels": ["dependencies", "drupal-contrib"],
      "automerge": false,
      "reviewers": ["team:maintainers"]
    },
    {
      "description": "PHP runtime (Dockerfile, setup-php, composer.json, .tool-versions)",
      "matchDepNames": ["php"],
      "groupName": "PHP runtime",
      "allowedVersions": ">=8.3 <8.5",
      "labels": ["dependencies", "runtime", "needs-prod-check"],
      "automerge": false,
      "reviewers": ["team:maintainers"]
    },
    {
      "description": "Node.js runtime (.nvmrc, setup-node, Dockerfile)",
      "matchDepNames": ["node"],
      "groupName": "Node.js runtime",
      "labels": ["dependencies", "runtime", "needs-prod-check"],
      "automerge": false,
      "reviewers": ["team:maintainers"]
    },
    {
      "description": "pnpm (packageManager field, pnpm/action-setup)",
      "matchDepNames": ["pnpm"],
      "groupName": "pnpm",
      "labels": ["dependencies", "runtime"],
      "automerge": false,
      "reviewers": ["team:maintainers"]
    },
    {
      "description": "Drupal core: always its own PR, never automerge (placed after the dev rule so it wins for drupal/core-dev)",
      "matchPackageNames": [
        "drupal/core",
        "drupal/core-*"
      ],
      "groupName": "Drupal core",
      "labels": ["dependencies", "drupal-core"],
      "automerge": false,
      "reviewers": ["team:maintainers"]
    },
    {
      "description": "PHPUnit: Drupal 11 core supports only PHPUnit 11 (core-dev ^11.5, sebastian/diff <8); raise with Drupal 12",
      "matchPackageNames": ["phpunit/phpunit"],
      "allowedVersions": "<12"
    },
    {
      "description": "Symfony test components: stay on 7.x like Drupal 11 core-dev (^7.4)",
      "matchPackageNames": [
        "symfony/browser-kit",
        "symfony/css-selector",
        "symfony/dom-crawler"
      ],
      "allowedVersions": "<8"
    },
    {
      "description": "Major updates: only created after approval in the Dependency Dashboard, label, never automerge (last rule so it overrides the others)",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "reviewers": ["team:maintainers"]
    }
  ]
}